{
  "expo": {
    "name": "NosePrint",
    "slug": "noseprint",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noseprint.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#C2562F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.noseprint.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "NosePrint",
      "shortName": "NosePrint",
      "themeColor": "#C2562F",
      "backgroundColor": "#FAF7F2"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "NosePrint needs your photos to turn your dog's nose into line art.",
          "cameraPermission": "NosePrint uses the camera to photograph your dog's nose."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "NosePrint saves your designs to your photo library.",
          "savePhotosPermission": "NosePrint saves your designs to your photo library."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F2",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#141311"
          }
        }
      ]
    ],
    "scheme": "noseprint",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "5f2c474e-3afe-4fba-b5a5-3052fd6ae6bf"
      }
    },
    "experiments": {
      "baseUrl": "/NosePrint"
    },
    "updates": {
      "url": "https://u.expo.dev/5f2c474e-3afe-4fba-b5a5-3052fd6ae6bf",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    }
  }
}